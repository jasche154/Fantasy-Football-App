# Copy to backend/.env and fill in what you use. Never commit .env.

# Optional: any SQLAlchemy URL. Defaults to backend/database/fantasy.db.
# DATABASE_URL=sqlite:///C:/path/to/fantasy.db

# FantasyPros API (ROS expert rankings). Without it the free weekly ECR snapshot is used.
FANTASYPROS_API_KEY=

# The Odds API (https://the-odds-api.com, free: 500 credits/month): Vegas player props,
# the most heavily weighted source in Week X rankings.
ODDS_API_KEY=

# Outside weekly sources to fetch (Yahoo's and ESPN's are unofficial endpoints; see docs/DATA_SOURCES.md).
# WEEKLY_SOURCES=["yahoo_experts","espn","vegas_props"]
# Let /api/rankings/weekly refresh stale sources itself.
# WEEKLY_AUTO_REFRESH=true
# AUTO_UPDATE=true            # load finished weeks, learn source weights, save pre-game projections

# Yahoo Fantasy API app (https://developer.yahoo.com/apps/). The redirect URI must match the app exactly.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=https://localhost:8000/callback

# Encrypts stored OAuth tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# AI assistant. Groq is the default; list more providers to fall back to when one hits its
# free-tier limit. Providers without a key are skipped. Gemini's and OpenRouter's free tiers
# may use your prompts (including league rosters and team names) for training/human review.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b   # or openai/gpt-oss-20b: faster, but invents more
# LLM_CHAIN=groq                   # e.g. groq,gemini,openrouter,ollama
# GEMINI_API_KEY=                  # https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.8-flash
# OPENROUTER_API_KEY=              # https://openrouter.ai/keys (free models: 50 requests/day)
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OLLAMA_MODEL=gpt-oss:20b         # local, no key; needs `ollama serve`
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Include PFR-sourced snap counts in AI tool results (see docs/DATA_SOURCES.md before enabling).
# AGENT_SHARE_PFR_DATA=false
