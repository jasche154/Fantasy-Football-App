# Copy to backend/.env and fill in what you use. Never commit .env.

# Optional: any SQLAlchemy URL. Defaults to backend/database/fantasy.db.
# DATABASE_URL=sqlite:///C:/path/to/fantasy.db

# FantasyPros API (ROS expert rankings). Without it the free weekly ECR snapshot is used.
FANTASYPROS_API_KEY=

# Yahoo Fantasy API app (https://developer.yahoo.com/apps/). The redirect URI must match the app exactly.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=https://localhost:8000/callback

# Encrypts stored OAuth tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# AI assistant (Groq)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Include PFR-sourced snap counts in AI tool results (see docs/DATA_SOURCES.md before enabling).
# AGENT_SHARE_PFR_DATA=false
